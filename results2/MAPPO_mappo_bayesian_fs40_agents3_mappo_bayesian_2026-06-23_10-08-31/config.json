{
    "algorithm": "MAPPO",
    "experiment_name": "mappo_bayesian",
    "use_belief": true,
    "use_gaussian": false,
    "use_lstm": false,
    "use_random_policy": false,
    "use_oracle_confidence": false,
    "use_cell_lstm": true,
    "env": {
        "field_size": 40,
        "num_agents": 3,
        "max_steps": 2000
    },
    "reward": {
        "type": "mappo_bayesian",
        "new_cell_weight": 1.0,
        "collision_weight": 1.0,
        "step_penalty": 0.01,
        "alignment_weight": 0.5,
        "completion_bonus": 1.0,
        "completion_threshold": 0.95,
        "accuracy_weight": 1.0
    },
    "training": {
        "num_episodes": 200,
        "lr": 5e-05,
        "gamma": 0.99,
        "clip_eps": 0.1,
        "lam": 0.95,
        "epochs": 3,
        "mini_batch_size": 16
    },
    "env_seed": 42
}